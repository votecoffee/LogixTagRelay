<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation Condition="'$(MSBuildProjectName)' != 'LogixTagRelay.Build'">true</EnablePackageValidation>
    <PackageValidationBaselineVersion Condition="'$(MSBuildProjectName)' != 'LogixTagRelay.Build' and '$(LogixTagRelayBaselineVersion)' != ''">$(LogixTagRelayBaselineVersion)</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'LogixTagRelay.Build'">
    <!-- Compatible with the .NET 8 SDK; the analyzer is never a consumer dependency. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt;PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
