<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(ConsumerFramework)' == ''">net8.0</TargetFramework>
    <TargetFramework Condition="'$(ConsumerFramework)' != ''">$(ConsumerFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RollForward>LatestPatch</RollForward>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Contracts/Contracts.csproj" />
    <PackageReference Include="LogixTagRelay.Design" Version="$(RelayPackageVersion)" />
    <PackageReference Include="LogixTagRelay.Logix" Version="$(RelayPackageVersion)" />
    <PackageReference Include="LogixTagRelay.Opener" Version="$(RelayPackageVersion)" />
    <PackageReference Include="LogixTagRelay.Emulation" Version="$(RelayPackageVersion)" />
  </ItemGroup>
</Project>
