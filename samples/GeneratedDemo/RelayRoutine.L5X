<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.00" TargetName="LogixRelay_PS_Sync" TargetType="Routine" ContainsContext="true" ExportOptions="References NoRawData DecoratedData Context Dependencies">
  <Controller Use="Context" Name="LogixRelayContext">
    <DataTypes />
    <Modules />
    <AddOnInstructionDefinitions Use="Context">
      <AddOnInstructionDefinition Use="Context" Name="LTR_SintMerge" Revision="1.0" Vendor="votecoffee" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2026-11-02T00:00:00.000Z" CreatedBy="LogixTagRelay" EditedDate="2026-11-02T00:00:00.000Z" EditedBy="LogixTagRelay" SoftwareRevision="v35.00">
        <Description><![CDATA[Three-way SINT merge; PLC wins. Actual InOut sizes are checked with SIZE. LastSent/Received must be distinct snapshots.]]></Description>
        <Parameters>
          <Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Required="false" Visible="false" Radix="Decimal" ExternalAccess="Read Only" />
          <Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Required="false" Visible="false" Radix="Decimal" ExternalAccess="Read Only" />
          <Parameter Name="LastSent" TagType="Base" DataType="SINT" Dimensions="1" Usage="InOut" Required="true" Visible="true" Constant="false" />
          <Parameter Name="Current" TagType="Base" DataType="SINT" Dimensions="1" Usage="InOut" Required="true" Visible="true" Constant="false" />
          <Parameter Name="Received" TagType="Base" DataType="SINT" Dimensions="1" Usage="InOut" Required="true" Visible="true" Constant="false" />
          <Parameter Name="Error" TagType="Base" DataType="BOOL" Usage="Output" Required="false" Visible="true" Radix="Decimal" ExternalAccess="Read Only">
            <DefaultData Format="Decorated">
              <DataValue DataType="BOOL" Radix="Decimal" Value="0" />
            </DefaultData>
          </Parameter>
          <Parameter Name="Status" TagType="Base" DataType="DINT" Usage="Output" Required="false" Visible="true" Radix="Decimal" ExternalAccess="Read Only">
            <DefaultData Format="Decorated">
              <DataValue DataType="DINT" Radix="Decimal" Value="0" />
            </DefaultData>
          </Parameter>
          <Parameter Name="PlcChangedBytes" TagType="Base" DataType="DINT" Usage="Output" Required="false" Visible="true" Radix="Decimal" ExternalAccess="Read Only">
            <DefaultData Format="Decorated">
              <DataValue DataType="DINT" Radix="Decimal" Value="0" />
            </DefaultData>
          </Parameter>
          <Parameter Name="ReceivedChangedBytes" TagType="Base" DataType="DINT" Usage="Output" Required="false" Visible="true" Radix="Decimal" ExternalAccess="Read Only">
            <DefaultData Format="Decorated">
              <DataValue DataType="DINT" Radix="Decimal" Value="0" />
            </DefaultData>
          </Parameter>
          <Parameter Name="ConflictBytes" TagType="Base" DataType="DINT" Usage="Output" Required="false" Visible="true" Radix="Decimal" ExternalAccess="Read Only">
            <DefaultData Format="Decorated">
              <DataValue DataType="DINT" Radix="Decimal" Value="0" />
            </DefaultData>
          </Parameter>
          <Parameter Name="AppliedBytes" TagType="Base" DataType="DINT" Usage="Output" Required="false" Visible="true" Radix="Decimal" ExternalAccess="Read Only">
            <DefaultData Format="Decorated">
              <DataValue DataType="DINT" Radix="Decimal" Value="0" />
            </DefaultData>
          </Parameter>
        </Parameters>
        <LocalTags>
          <LocalTag Name="LastSize" DataType="DINT" Radix="Decimal" ExternalAccess="None" />
          <LocalTag Name="CurrentSize" DataType="DINT" Radix="Decimal" ExternalAccess="None" />
          <LocalTag Name="ReceivedSize" DataType="DINT" Radix="Decimal" ExternalAccess="None" />
          <LocalTag Name="Index" DataType="DINT" Radix="Decimal" ExternalAccess="None" />
        </LocalTags>
        <Routines>
          <Routine Name="Logic" Type="ST">
            <STContent>
              <Line Number="0"><![CDATA[// PLC-first three-way merge. LastSent and Received are never modified.]]></Line>
              <Line Number="1"><![CDATA[Error := 0;]]></Line>
              <Line Number="2"><![CDATA[Status := 0;]]></Line>
              <Line Number="3"><![CDATA[PlcChangedBytes := 0;]]></Line>
              <Line Number="4"><![CDATA[ReceivedChangedBytes := 0;]]></Line>
              <Line Number="5"><![CDATA[ConflictBytes := 0;]]></Line>
              <Line Number="6"><![CDATA[AppliedBytes := 0;]]></Line>
              <Line Number="7"><![CDATA[SIZE(LastSent, 0, LastSize);]]></Line>
              <Line Number="8"><![CDATA[SIZE(Current, 0, CurrentSize);]]></Line>
              <Line Number="9"><![CDATA[SIZE(Received, 0, ReceivedSize);]]></Line>
              <Line Number="10"><![CDATA[]]></Line>
              <Line Number="11"><![CDATA[IF (LastSize <> CurrentSize) OR (ReceivedSize <> CurrentSize) OR (CurrentSize <= 0) THEN]]></Line>
              <Line Number="12"><![CDATA[    Error := 1;]]></Line>
              <Line Number="13"><![CDATA[    Status := 1;]]></Line>
              <Line Number="14"><![CDATA[ELSE]]></Line>
              <Line Number="15"><![CDATA[    FOR Index := 0 TO CurrentSize - 1 DO]]></Line>
              <Line Number="16"><![CDATA[        IF Current[Index] <> LastSent[Index] THEN]]></Line>
              <Line Number="17"><![CDATA[            PlcChangedBytes := PlcChangedBytes + 1;]]></Line>
              <Line Number="18"><![CDATA[        END_IF;]]></Line>
              <Line Number="19"><![CDATA[        IF Received[Index] <> LastSent[Index] THEN]]></Line>
              <Line Number="20"><![CDATA[            ReceivedChangedBytes := ReceivedChangedBytes + 1;]]></Line>
              <Line Number="21"><![CDATA[        END_IF;]]></Line>
              <Line Number="22"><![CDATA[        IF (Current[Index] <> LastSent[Index]) AND (Received[Index] <> LastSent[Index]) AND (Current[Index] <> Received[Index]) THEN]]></Line>
              <Line Number="23"><![CDATA[            ConflictBytes := ConflictBytes + 1;]]></Line>
              <Line Number="24"><![CDATA[        END_IF;]]></Line>
              <Line Number="25"><![CDATA[        IF Current[Index] = LastSent[Index] THEN]]></Line>
              <Line Number="26"><![CDATA[            IF Current[Index] <> Received[Index] THEN]]></Line>
              <Line Number="27"><![CDATA[                AppliedBytes := AppliedBytes + 1;]]></Line>
              <Line Number="28"><![CDATA[            END_IF;]]></Line>
              <Line Number="29"><![CDATA[            Current[Index] := Received[Index];]]></Line>
              <Line Number="30"><![CDATA[        END_IF;]]></Line>
              <Line Number="31"><![CDATA[    END_FOR;]]></Line>
              <Line Number="32"><![CDATA[END_IF;]]></Line>
              <Line Number="33"><![CDATA[EnableOut := NOT Error;]]></Line>
            </STContent>
          </Routine>
        </Routines>
      </AddOnInstructionDefinition>
    </AddOnInstructionDefinitions>
    <Tags />
    <Programs>
      <Program Use="Context" Name="MainProgram">
        <Tags>
          <Tag Name="LogixRelay_PS_Rx" TagType="Base" DataType="SINT" Dimensions="60" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_Tx" TagType="Base" DataType="SINT" Dimensions="60" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_Current" TagType="Base" DataType="SINT" Dimensions="36" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_LastSent" TagType="Base" DataType="SINT" Dimensions="36" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_Received" TagType="Base" DataType="SINT" Dimensions="36" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_Magic" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_Version" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_Schema" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_Valid" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_CommandSequence" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_BaselineSequence" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_AcceptedSequence" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_Sequence" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_Bool" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_HeaderMagic" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_HeaderVersion" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_HeaderSchema" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_HeaderValid" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_ApplyCommands" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_Initialized" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_Reset" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_FrameValid" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_CurrentValid" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_MergedValid" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_Publish" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_Watchdog" TagType="Base" DataType="TIMER" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
          <Tag Name="LogixRelay_PS_Merge" TagType="Base" DataType="LTR_SintMerge" Constant="false" ExternalAccess="Read/Write" />
        </Tags>
        <Routines>
          <Routine Use="Target" Name="LogixRelay_PS_Sync" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[Hold Reset during connection/state reconciliation; release it before enabling commands. Restart the API session after reset.]]></Comment>
                <Text><![CDATA[XIC(LogixRelay_PS_Reset)OTU(LogixRelay_PS_Initialized)MOV(0,LogixRelay_PS_Sequence)MOV(0,LogixRelay_PS_AcceptedSequence);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment><![CDATA[Snapshot module input TO the PLC. Header is excluded from the three merge arrays.]]></Comment>
                <Text><![CDATA[CPS(LogixRelay:I.Data[0],LogixRelay_PS_Rx[0],60);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Text><![CDATA[CPS(LogixRelay_PS_Rx[0],LogixRelay_PS_Magic,1);]]></Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Text><![CDATA[CPS(LogixRelay_PS_Rx[4],LogixRelay_PS_Version,1);]]></Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Text><![CDATA[CPS(LogixRelay_PS_Rx[8],LogixRelay_PS_Schema,1);]]></Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Text><![CDATA[CPS(LogixRelay_PS_Rx[12],LogixRelay_PS_CommandSequence,1);]]></Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Text><![CDATA[CPS(LogixRelay_PS_Rx[16],LogixRelay_PS_BaselineSequence,1);]]></Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Text><![CDATA[CPS(LogixRelay_PS_Rx[20],LogixRelay_PS_Valid,1);]]></Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Text><![CDATA[FLL(0,LogixRelay_PS_Current[0],36);]]></Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Text><![CDATA[MOV(0,LogixRelay_PS_Bool);]]></Text>
              </Rung>
              <Rung Number="10" Type="N">
                <Text><![CDATA[XIC(Status.Running)MOV(1,LogixRelay_PS_Bool);]]></Text>
              </Rung>
              <Rung Number="11" Type="N">
                <Text><![CDATA[CPS(LogixRelay_PS_Bool,LogixRelay_PS_Current[0],4);]]></Text>
              </Rung>
              <Rung Number="12" Type="N">
                <Text><![CDATA[CPS(Status.Speed,LogixRelay_PS_Current[4],4);]]></Text>
              </Rung>
              <Rung Number="13" Type="N">
                <Text><![CDATA[CPS(Status.Count,LogixRelay_PS_Current[8],8);]]></Text>
              </Rung>
              <Rung Number="14" Type="N">
                <Text><![CDATA[CPS(Status.Faults[0],LogixRelay_PS_Current[16],4);]]></Text>
              </Rung>
              <Rung Number="15" Type="N">
                <Text><![CDATA[CPS(Status.Faults[1],LogixRelay_PS_Current[20],4);]]></Text>
              </Rung>
              <Rung Number="16" Type="N">
                <Text><![CDATA[CPS(Status.Faults[2],LogixRelay_PS_Current[24],4);]]></Text>
              </Rung>
              <Rung Number="17" Type="N">
                <Text><![CDATA[MOV(0,LogixRelay_PS_Bool);]]></Text>
              </Rung>
              <Rung Number="18" Type="N">
                <Text><![CDATA[XIC(Command.Enable)MOV(1,LogixRelay_PS_Bool);]]></Text>
              </Rung>
              <Rung Number="19" Type="N">
                <Text><![CDATA[CPS(LogixRelay_PS_Bool,LogixRelay_PS_Current[28],4);]]></Text>
              </Rung>
              <Rung Number="20" Type="N">
                <Text><![CDATA[CPS(Command.Setpoint,LogixRelay_PS_Current[32],4);]]></Text>
              </Rung>
              <Rung Number="21" Type="N">
                <Text><![CDATA[XIO(LogixRelay_PS_Reset)OTE(LogixRelay_PS_CurrentValid);]]></Text>
              </Rung>
              <Rung Number="22" Type="N">
                <Comment><![CDATA[Accept only a fresh command referencing the exact frozen snapshot last written to module output. Validate incoming string lengths before merge.]]></Comment>
                <Text><![CDATA[XIC(LogixRelay_PS_ApplyCommands)XIC(LogixRelay_PS_Initialized)XIC(LogixRelay_PS_CurrentValid)EQU(LogixRelay_PS_Magic,1347637297)EQU(LogixRelay_PS_Version,3)EQU(LogixRelay_PS_Schema,1690229826)EQU(LogixRelay_PS_Valid,1)GRT(LogixRelay_PS_CommandSequence,0)NEQ(LogixRelay_PS_CommandSequence,LogixRelay_PS_AcceptedSequence)EQU(LogixRelay_PS_BaselineSequence,LogixRelay_PS_Sequence)OTE(LogixRelay_PS_FrameValid);]]></Text>
              </Rung>
              <Rung Number="23" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_FrameValid)RES(LogixRelay_PS_Watchdog);]]></Text>
              </Rung>
              <Rung Number="24" Type="N">
                <Comment><![CDATA[Repeated wire packets cannot refresh this watchdog. Fresh matching generations can recover it.]]></Comment>
                <Text><![CDATA[TON(LogixRelay_PS_Watchdog,1000,0);]]></Text>
              </Rung>
              <Rung Number="25" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_FrameValid)CPS(LogixRelay_PS_Rx[24],LogixRelay_PS_Received[0],36);]]></Text>
              </Rung>
              <Rung Number="26" Type="N">
                <Comment><![CDATA[Preserve PLC-only ownership in the wrapper; the AOI has no type or direction metadata.]]></Comment>
                <Text><![CDATA[XIC(LogixRelay_PS_FrameValid)CPS(LogixRelay_PS_Current[0],LogixRelay_PS_Received[0],4);]]></Text>
              </Rung>
              <Rung Number="27" Type="N">
                <Comment><![CDATA[Preserve PLC-only ownership in the wrapper; the AOI has no type or direction metadata.]]></Comment>
                <Text><![CDATA[XIC(LogixRelay_PS_FrameValid)CPS(LogixRelay_PS_Current[4],LogixRelay_PS_Received[4],4);]]></Text>
              </Rung>
              <Rung Number="28" Type="N">
                <Comment><![CDATA[Preserve PLC-only ownership in the wrapper; the AOI has no type or direction metadata.]]></Comment>
                <Text><![CDATA[XIC(LogixRelay_PS_FrameValid)CPS(LogixRelay_PS_Current[8],LogixRelay_PS_Received[8],8);]]></Text>
              </Rung>
              <Rung Number="29" Type="N">
                <Comment><![CDATA[Preserve PLC-only ownership in the wrapper; the AOI has no type or direction metadata.]]></Comment>
                <Text><![CDATA[XIC(LogixRelay_PS_FrameValid)CPS(LogixRelay_PS_Current[16],LogixRelay_PS_Received[16],4);]]></Text>
              </Rung>
              <Rung Number="30" Type="N">
                <Comment><![CDATA[Preserve PLC-only ownership in the wrapper; the AOI has no type or direction metadata.]]></Comment>
                <Text><![CDATA[XIC(LogixRelay_PS_FrameValid)CPS(LogixRelay_PS_Current[20],LogixRelay_PS_Received[20],4);]]></Text>
              </Rung>
              <Rung Number="31" Type="N">
                <Comment><![CDATA[Preserve PLC-only ownership in the wrapper; the AOI has no type or direction metadata.]]></Comment>
                <Text><![CDATA[XIC(LogixRelay_PS_FrameValid)CPS(LogixRelay_PS_Current[24],LogixRelay_PS_Received[24],4);]]></Text>
              </Rung>
              <Rung Number="32" Type="N">
                <Comment><![CDATA[The Structured Text AOI merges exactly three equally sized SINT payload arrays. PLC wins each changed byte.]]></Comment>
                <Text><![CDATA[XIC(LogixRelay_PS_FrameValid)LTR_SintMerge(LogixRelay_PS_Merge,LogixRelay_PS_LastSent,LogixRelay_PS_Current,LogixRelay_PS_Received);]]></Text>
              </Rung>
              <Rung Number="33" Type="N">
                <Comment><![CDATA[Validate merged STRING LENs before changing any destination. Invalid merges are not applied or acknowledged.]]></Comment>
                <Text><![CDATA[XIC(LogixRelay_PS_FrameValid)XIO(LogixRelay_PS_Merge.Error)OTE(LogixRelay_PS_MergedValid);]]></Text>
              </Rung>
              <Rung Number="34" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_MergedValid)CPS(LogixRelay_PS_Current[28],LogixRelay_PS_Bool,1);]]></Text>
              </Rung>
              <Rung Number="35" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_MergedValid)[NEQ(LogixRelay_PS_Bool,0)OTL(Command.Enable),EQU(LogixRelay_PS_Bool,0)OTU(Command.Enable)];]]></Text>
              </Rung>
              <Rung Number="36" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_MergedValid)CPS(LogixRelay_PS_Current[32],Command.Setpoint,1);]]></Text>
              </Rung>
              <Rung Number="37" Type="N">
                <Comment><![CDATA[ACK means merge completed, including bytes retained by the PLC. It does not mean every requested API byte won.]]></Comment>
                <Text><![CDATA[XIC(LogixRelay_PS_MergedValid)MOV(LogixRelay_PS_CommandSequence,LogixRelay_PS_AcceptedSequence);]]></Text>
              </Rung>
              <Rung Number="38" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_CurrentValid)[XIO(LogixRelay_PS_Initialized),XIC(LogixRelay_PS_MergedValid)]OTE(LogixRelay_PS_Publish);]]></Text>
              </Rung>
              <Rung Number="39" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)FLL(0,LogixRelay_PS_Tx[0],60);]]></Text>
              </Rung>
              <Rung Number="40" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)MOV(0,LogixRelay_PS_Bool);]]></Text>
              </Rung>
              <Rung Number="41" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)XIC(Status.Running)MOV(1,LogixRelay_PS_Bool);]]></Text>
              </Rung>
              <Rung Number="42" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)CPS(LogixRelay_PS_Bool,LogixRelay_PS_Tx[24],4);]]></Text>
              </Rung>
              <Rung Number="43" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)CPS(Status.Speed,LogixRelay_PS_Tx[28],4);]]></Text>
              </Rung>
              <Rung Number="44" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)CPS(Status.Count,LogixRelay_PS_Tx[32],8);]]></Text>
              </Rung>
              <Rung Number="45" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)CPS(Status.Faults[0],LogixRelay_PS_Tx[40],4);]]></Text>
              </Rung>
              <Rung Number="46" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)CPS(Status.Faults[1],LogixRelay_PS_Tx[44],4);]]></Text>
              </Rung>
              <Rung Number="47" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)CPS(Status.Faults[2],LogixRelay_PS_Tx[48],4);]]></Text>
              </Rung>
              <Rung Number="48" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)MOV(0,LogixRelay_PS_Bool);]]></Text>
              </Rung>
              <Rung Number="49" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)XIC(Command.Enable)MOV(1,LogixRelay_PS_Bool);]]></Text>
              </Rung>
              <Rung Number="50" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)CPS(LogixRelay_PS_Bool,LogixRelay_PS_Tx[52],4);]]></Text>
              </Rung>
              <Rung Number="51" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)CPS(Command.Setpoint,LogixRelay_PS_Tx[56],4);]]></Text>
              </Rung>
              <Rung Number="52" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)EQU(LogixRelay_PS_Sequence,2147483647)MOV(0,LogixRelay_PS_Sequence);]]></Text>
              </Rung>
              <Rung Number="53" Type="N">
                <Comment><![CDATA[Advance only after startup or a completed exchange; hold the snapshot while waiting for its reply.]]></Comment>
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)ADD(LogixRelay_PS_Sequence,1,LogixRelay_PS_Sequence);]]></Text>
              </Rung>
              <Rung Number="54" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)MOV(1347637297,LogixRelay_PS_HeaderMagic)MOV(3,LogixRelay_PS_HeaderVersion)MOV(1690229826,LogixRelay_PS_HeaderSchema)MOV(1,LogixRelay_PS_HeaderValid);]]></Text>
              </Rung>
              <Rung Number="55" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)CPS(LogixRelay_PS_HeaderMagic,LogixRelay_PS_Tx[0],4);]]></Text>
              </Rung>
              <Rung Number="56" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)CPS(LogixRelay_PS_HeaderVersion,LogixRelay_PS_Tx[4],4);]]></Text>
              </Rung>
              <Rung Number="57" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)CPS(LogixRelay_PS_HeaderSchema,LogixRelay_PS_Tx[8],4);]]></Text>
              </Rung>
              <Rung Number="58" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)CPS(LogixRelay_PS_Sequence,LogixRelay_PS_Tx[12],4);]]></Text>
              </Rung>
              <Rung Number="59" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)CPS(LogixRelay_PS_AcceptedSequence,LogixRelay_PS_Tx[16],4);]]></Text>
              </Rung>
              <Rung Number="60" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)CPS(LogixRelay_PS_HeaderValid,LogixRelay_PS_Tx[20],4);]]></Text>
              </Rung>
              <Rung Number="61" Type="N">
                <Comment><![CDATA[Write output FROM the PLC, then save exactly that payload as the baseline.]]></Comment>
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)CPS(LogixRelay_PS_Tx[0],LogixRelay:O.Data[0],60);]]></Text>
              </Rung>
              <Rung Number="62" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)CPS(LogixRelay_PS_Tx[24],LogixRelay_PS_LastSent[0],36);]]></Text>
              </Rung>
              <Rung Number="63" Type="N">
                <Text><![CDATA[XIC(LogixRelay_PS_Publish)OTL(LogixRelay_PS_Initialized);]]></Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
  </Controller>
</RSLogix5000Content>
