              <Rung Number="72" Type="N">
                <Text><![CDATA[CPS(Request.Recipe,LogixRelay_PS_Tx[344],132);]]></Text>
              </Rung>
              <Rung Number="73" Type="N">
                <Text><![CDATA[LES(Request.Recipe.LEN,0)MOV(0,LogixRelay_PS_HeaderValid);]]></Text>
              </Rung>
              <Rung Number="74" Type="N">
                <Text><![CDATA[GRT(Request.Recipe.LEN,128)MOV(0,LogixRelay_PS_HeaderValid);]]></Text>
              </Rung>
              <Rung Number="75" Type="N">
                <Text><![CDATA[MOV(0,LogixRelay_PS_Bool);]]></Text>
              </Rung>
              <Rung Number="76" Type="N">
                <Text><![CDATA[XIC(Request.Execute)MOV(1,LogixRelay_PS_Bool);]]></Text>
              </Rung>
              <Rung Number="77" Type="N">
                <Text><![CDATA[CPS(LogixRelay_PS_Bool,LogixRelay_PS_Tx[476],4);]]></Text>
              </Rung>
              <Rung Number="78" Type="N">
                <Text><![CDATA[EQU(LogixRelay_PS_Sequence,2147483647)MOV(-1,LogixRelay_PS_Sequence);]]></Text>
              </Rung>
              <Rung Number="79" Type="N">
                <Comment><![CDATA[Wrap to zero before signed ADD overflow. Sequence advances on each routine execution.]]></Comment>
                <Text><![CDATA[ADD(LogixRelay_PS_Sequence,1,LogixRelay_PS_Sequence);]]></Text>
              </Rung>
              <Rung Number="80" Type="N">
                <Text><![CDATA[MOV(1347637297,LogixRelay_PS_HeaderMagic)MOV(2,LogixRelay_PS_HeaderVersion)MOV(517735648,LogixRelay_PS_HeaderSchema);]]></Text>
              </Rung>
              <Rung Number="81" Type="N">
                <Text><![CDATA[CPS(LogixRelay_PS_HeaderMagic,LogixRelay_PS_Tx[0],4);]]></Text>
              </Rung>
              <Rung Number="82" Type="N">
                <Text><![CDATA[CPS(LogixRelay_PS_HeaderVersion,LogixRelay_PS_Tx[4],4);]]></Text>
