                <Text><![CDATA[LES(Stations[1,1].Name.LEN,0)MOV(0,LogixRelay_PS_HeaderValid);]]></Text>
              </Rung>
              <Rung Number="65" Type="N">
                <Text><![CDATA[GRT(Stations[1,1].Name.LEN,12)MOV(0,LogixRelay_PS_HeaderValid);]]></Text>
              </Rung>
              <Rung Number="66" Type="N">
