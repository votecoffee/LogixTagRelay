              </Rung>
              <Rung Number="46" Type="N">
                <Text><![CDATA[LES(Stations[0,1].Name.LEN,0)MOV(0,LogixRelay_PS_HeaderValid);]]></Text>
              </Rung>
              <Rung Number="47" Type="N">
