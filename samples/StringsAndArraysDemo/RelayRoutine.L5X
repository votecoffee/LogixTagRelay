            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment><![CDATA[Hold Reset during connection/state reconciliation; release it before enabling commands. Managed sessions negotiate a fresh baseline after reset.]]></Comment>
                <Text><![CDATA[XIC(LogixRelay_PS_Reset)OTU(LogixRelay_PS_Initialized)MOV(0,LogixRelay_PS_Sequence)MOV(0,LogixRelay_PS_AcceptedSequence);]]></Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment><![CDATA[Snapshot module input TO the PLC. Header is excluded from the three merge arrays.]]></Comment>
                <Text><![CDATA[CPS(LogixRelay:I.Data[0],LogixRelay_PS_Rx[0],480);]]></Text>
              </Rung>
              <Rung Number="2" Type="N">
