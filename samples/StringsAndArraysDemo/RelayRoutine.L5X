              <Rung Number="8" Type="N">
                <Comment><![CDATA[A new nonce requests a fresh frozen baseline without applying any API payload.]]></Comment>
                <Text><![CDATA[XIO(LogixRelay_PS_Reset)EQU(LogixRelay_PS_Magic,1347637297)EQU(LogixRelay_PS_Version,3)EQU(LogixRelay_PS_Schema,517735648)EQU(LogixRelay_PS_Valid,2)GRT(LogixRelay_PS_BaselineSequence,0)NEQ(LogixRelay_PS_BaselineSequence,LogixRelay_PS_ResyncNonce)MOV(LogixRelay_PS_BaselineSequence,LogixRelay_PS_ResyncNonce)OTL(LogixRelay_PS_ResyncPending)OTU(LogixRelay_PS_Initialized)MOV(0,LogixRelay_PS_Sequence)MOV(0,LogixRelay_PS_AcceptedSequence);]]></Text>
