      <Program Use="Context" Name="MainProgram">
        <Tags>
          <Tag Name="LogixRelay_PS_Rx" TagType="Base" DataType="SINT" Dimensions="480" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" />
