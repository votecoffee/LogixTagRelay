              </Rung>
              <Rung Number="37" Type="N">
                <Text><![CDATA[LES(Stations[0,0].Name.LEN,0)MOV(0,LogixRelay_PS_HeaderValid);]]></Text>
              </Rung>
              <Rung Number="38" Type="N">
                <Text><![CDATA[GRT(Stations[0,0].Name.LEN,12)MOV(0,LogixRelay_PS_HeaderValid);]]></Text>
              </Rung>
              <Rung Number="39" Type="N">
                <Text><![CDATA[MOV(0,LogixRelay_PS_Bool);]]></Text>
              </Rung>
              <Rung Number="40" Type="N">
                <Text><![CDATA[XIC(Stations[0,0].Enabled)MOV(1,LogixRelay_PS_Bool);]]></Text>
              </Rung>
              <Rung Number="41" Type="N">
                <Text><![CDATA[CPS(LogixRelay_PS_Bool,LogixRelay_PS_Tx[232],4);]]></Text>
              </Rung>
